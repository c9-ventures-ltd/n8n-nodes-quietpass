      "name": "Spending permission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        440
      ],
      "parameters": {
        "jsCode": "function spendingGate(config,limits){\n if(typeof config.allowPaid!=='boolean'||!Number.isSafeInteger(config.maximumMicros)||config.maximumMicros<0||config.maximumMicros>1000000||!Array.isArray(config.checks)||!config.checks.length||config.checks.some(c=>!['basic_line_type','enhanced_line_type','current_carrier','mnp','live_status','sms','whatsapp','telegram'].includes(c)))throw Error('Review the workflow checks and spending ceiling.');\n const paid=config.checks.some(c=>c!=='basic_line_type');\n const reason=limits.available!==true?'workflow_access_unavailable':limits.enabled!==true?'purchases_paused':!['GBP','USD','EUR'].includes(limits.currency)?'currency_unavailable':paid&&config.allowPaid!==true?'paid_use_disabled':paid&&config.maximumMicros===0?'zero_spending_ceiling':config.maximumMicros>limits.maximumMicros?'workspace_ceiling_exceeded':null;\n return {allowed:reason===null,reason,currency:limits.currency,maximumMicros:config.maximumMicros};\n}\nreturn [{json:spendingGate($('Configuration').first().json,$json)}];"
      }
