      ],
      "parameters": {
        "jsCode": "function phoneRevision(contact){\n const history=contact.propertiesWithHistory?.phone;\n if(!Array.isArray(history)||!history.length)return null;\n const sorted=history.filter(v=>typeof v.timestamp==='string'&&Number.isFinite(Date.parse(v.timestamp))).sort((a,b)=>Date.parse(b.timestamp)-Date.parse(a.timestamp));\n return sorted[0]?.timestamp??null;\n}\nfunction contactIdentity(contact,config){\n if(!/^[1-9][0-9]{0,25}$/.test(config.contactId)||!/^[1-9][0-9]{0,25}$/.test(config.portalId)||String(contact.id)!==config.contactId||contact.archived===true)throw Error('Check the contact ID and HubSpot credential account.');\n const revision=phoneRevision(contact),phone=contact.properties?.phone;\n return {contactId:config.contactId,revision,phone:typeof phone==='string'?phone:'',country:contact.properties?.hs_country_region_code||config.defaultCountry||'',needsReview:!revision||!phone,reason:!phone?'empty_phone':!revision?'phone_history_required':null};\n}\nreturn [{json:contactIdentity($json,$('Configuration').first().json)}];"
      }
