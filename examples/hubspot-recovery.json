            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Retain operation for review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write QuietPass fields": {
      "main": [
        [
          {
            "node": "Write receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true,
    "executionTimeout": 120
  },
  "pinData": {},
  "tags": []
}
